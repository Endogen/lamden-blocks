                                "code": "# SURPRISE! SIMPLE SECURE Liquidity Lockers by mintorburn.com\nimport con_rocketswap_official_v1_1 as rocketswap\n\nlockers = Hash(default_value=0)\nmetadata = Hash()\n\n@construct\ndef seed():\n    metadata['FEE_PERCENTAGE'] = 2\n    metadata['FEE_WALLET'] = \"ff61544ea94eaaeb5df08ed863c4a938e9129aba6ceee5f31b6681bdede11b89\"\n    metadata['OWNER'] = ctx.caller\n\n@export\ndef create_locker(token_contract: str, lp_amount: float, lock_till: datetime.datetime):\n    assert lp_amount > 0, 'Must provide lp points amount!'\n    assert token_contract != None, 'Must provide token contract!'\n    assert lock_till != None, 'Must provide end date of lock!'\n    rocketswap.transfer_liquidity_from(contract=token_contract, to=ctx.this, main_account=ctx.caller, amount=lp_amount)\n    rocketswap.transfer_liquidity(contract=token_contract, to=metadata['FEE_WALLET'], amount=lp_amount/100*metadata['FEE_PERCENTAGE'])\n    lockers[token_contract] += Hash([lp_amount, lock_till, ctx.caller])\n\n@export\ndef end_locker(token_contract: str):\n    assert token_contract != None, 'Must provide token contract!'\n    assert lockers[token_contract, 2] < now, 'The end of liquidity lock is not reached yet!'\n    assert lockers[token_contract, 3] == ctx.caller, 'Only the creator of the lock can end it!'\n    rocketswap.transfer_liquidity(contract=token_contract, to=ctx.caller, amount=lockers[token_contract, 1])\n\n@export\ndef get_all_lockers():\n    return lockers\n\n@export\ndef get_locked_lp(token_contract: str):\n    assert token_contract != None, 'Must provide token contract!'\n    return lockers[token_contract]\n\n@export\ndef change_metadata(key: str, value: Any):\n    assert ctx.caller == metadata['OWNER'\n        ], 'Only owner can set metadata!'\n    metadata[key] = value\n    \n",
